PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (add your database name after .mongodb.net/)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/learnix?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL allowed by CORS
CLIENT_URL=http://localhost:5173

# Admin account created automatically on first start
ADMIN_NAME=LearnSphere Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password